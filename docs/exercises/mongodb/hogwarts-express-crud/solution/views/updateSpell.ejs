<%- include("partials/header") %>

<form method="post" action="/spells/<%= spell.id %>/update">
    <div class="spell-card">

        <% for (const field of FIELDS) { %>

            <label for="<%= field.name %>"><%= field.name %></label>
            <% if (field.type === "spelltype") { %>
                <select name="<%= field.name %>" id="<%= field.name %>">
                    <% for (let spellType of SPELL_TYPES) { %>
                        <option><%= spellType %></option>
                    <% } %>
                </select>
            <% } else { %>
                <input type="<%= field.type %>" name="<%= field.name %>" id="<%= field.name %>" value="<%= spell[field.name] %>" <%= field.readonly ? "readonly" : "" %>/>
            <% } %>

        <% } %>

    </div>

    <button type="submit">Update</button>
</form>

<%- include("partials/footer") %>